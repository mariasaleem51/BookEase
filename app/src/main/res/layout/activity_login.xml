<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo Image -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/logo"
        android:scaleType="centerInside"
        android:contentDescription="Logo" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back!"
        android:textColor="#1A1A1A"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Sub-heading with Proper Spacing -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:text="Sign in to continue booking appointments"
        android:textColor="#6C757D"
        android:textSize="14sp" />

    <!-- Email Field (Text color set to Black) -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Email Address"
        android:textColorHint="#6C757D"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="#000000"
        android:textSize="15sp" />

    <!-- Password Field (Text color set to Black) -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Password"
        android:textColorHint="#6C757D"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="#000000"
        android:textSize="15sp" />

    <!-- Login Button (Text remains White) -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#7053DB"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Google Sign-In Button -->
    <Button
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#F8F9FA"
        android:text="Sign in with Google"
        android:textAllCaps="false"
        android:textColor="#3C4043"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Navigate to Sign Up -->
    <TextView
        android:id="@+id/tvGoToSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Don't have an account? Sign Up"
        android:textColor="#7053DB"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>